generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PANUser {
  id                    Int      @id @default(autoincrement())
  email                 String   @unique
  password              String
  name                  String?
  role                  String
  isDeleted             Boolean  @default(false)
  resetToken            String?
  resetTokenExpiry      DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
