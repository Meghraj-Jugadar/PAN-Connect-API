generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// model: PANUser
model PANUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   // Added password field
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // Good practice to track updates
}
